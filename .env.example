# ────────────────────────────────────────────────────────────────────────
# IntelliDocs AI — environment variables
#
# Copy this file to `.env` and fill in the values you need:
#   cp .env.example .env
#
# The embedding model (sentence-transformers/all-MiniLM-L6-v2) runs fully
# locally and needs NO token. Only the answer-generation LLM needs one.
# ────────────────────────────────────────────────────────────────────────

# Required for the default "Hugging Face (free)" provider.
# Get a free token at: https://huggingface.co/settings/tokens
HUGGINGFACEHUB_API_TOKEN=

# Optional — only needed if you pick "OpenAI" as the provider in the sidebar.
OPENAI_API_KEY=

# Optional — only needed if you pick "Groq" as the provider in the sidebar.
GROQ_API_KEY=
